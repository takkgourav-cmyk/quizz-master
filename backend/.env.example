PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/quizly
JWT_SECRET=replace-with-a-long-random-secret
PASSWORD_RESET_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-seeding

# Gmail SMTP: enable 2-Step Verification and create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Quizly <your-email@gmail.com>
